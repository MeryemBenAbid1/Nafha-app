# Copy this file to .env.local and fill it in from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret. Server only. Never put it in a NEXT_PUBLIC_ variable or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The public address of the app, used inside QR codes. On Vercel, set it to your vercel.app URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: the Python model service. Leave empty to use the stub classifier.
CLASSIFIER_URL=

# Blockchain (see nafha-chain/README.md). Leave empty until the contract is deployed.
# Polygon Amoy: 80002 and an Amoy RPC URL. Booth offline: 31337 and http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_ANCHOR_CONTRACT=
# Secret. A TEST wallet only, the one that deployed NafhaAnchor. Never a wallet with real money.
ANCHOR_PRIVATE_KEY=

# NFC seals (NTAG 424 DNA SUN): the 16-byte AES keys you programmed into the tags, as hex. Secret.
SUN_K_META=
SUN_K_FILE=

# Instead of SUPABASE_SERVICE_ROLE_KEY you can use a 'server' account (see supabase/migrations/002).
SERVER_EMAIL=
SERVER_PASSWORD=

# Optional demo: a fake device built into the server ("Simulate a sniff" button on the technician screen).
DEMO_DEVICE_ID=
DEMO_DEVICE_PRIVATE_KEY=
